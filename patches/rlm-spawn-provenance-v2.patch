@@ -0,0 +1,302 @@
+from __future__ import annotations
+
+import asyncio
+import json
+from pathlib import Path
+from typing import Any, ClassVar
+
+import pytest
+import rlm.api as api
+from conftest import DummyClient, DummyMessage
+from rlm.client import call_with_retries
+from rlm.engine import RLMEngine
+from rlm.provenance import RLMProvenanceV2
+from rlm.session import Session
+from rlm.types import RLMResult
+
+
+def _parent(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> Path:
+    parent = tmp_path / "root-session"
+    parent.mkdir()
+    (parent / "messages.jsonl").write_text(
+        json.dumps(
+            {
+                "type": "assistant",
+                "turn": 4,
+                "session_call_ordinal": 7,
+                "tool_calls": [{"id": "generated-call", "name": "ipython"}],
+            }
+        )
+        + "\n",
+        encoding="utf-8",
+    )
+    monkeypatch.setenv("RLM_SESSION_DIR", str(parent))
+    monkeypatch.setenv("RLM_ROOT_SESSION_DIR", str(parent))
+    monkeypatch.setenv("RLM_LINEAGE", "root")
+    monkeypatch.setenv("RLM_DEPTH", "1")
+    api._scope_reservations.clear()
+    api._completed_spawns.clear()
+    return parent
+
+
+class _FakeEngine:
+    sessions: ClassVar[list[Session]] = []
+
+    def __init__(self, **kwargs: Any):
+        self.session = kwargs["session"]
+        self.sessions.append(self.session)
+
+    async def run(self, prompt: str) -> RLMResult:
+        if prompt == "slow":
+            await asyncio.sleep(0.01)
+        if prompt == "wait":
+            await asyncio.Future()
+        if prompt == "fail":
+            raise RuntimeError("child failed")
+        self.session.close()
+        return RLMResult(answer=prompt, session_dir=self.session.dir)
+
+
+def test_child_lineage_matches_cross_repository_golden_vector() -> None:
+    assert RLMProvenanceV2.derive_child_lineage(
+        parent_lineage="root",
+        depth=1,
+        parent_call_ordinal=3,
+        parent_tool_call_slot=0,
+        spawn_ordinal=2,
+    ) == "root/7ef6d951f46aae83454a5964"
+
+
+def test_partial_child_provenance_is_rejected_before_session_creation() -> None:
+    with pytest.raises(ValueError, match="incomplete"):
+        RLMProvenanceV2(depth=1, lineage="root/incomplete")
+
+
+@pytest.fixture(autouse=True)
+def _fake_engine(monkeypatch: pytest.MonkeyPatch) -> None:
+    _FakeEngine.sessions.clear()
+    monkeypatch.setattr(api, "RLMEngine", _FakeEngine)
+
+
+async def test_reserves_before_scheduling_and_ignores_completion_order(
+    tmp_path: Path,
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    parent = _parent(tmp_path, monkeypatch)
+
+    slow = api.run("slow", redco_invocation_id="duplicate")
+    fast = api.run("fast", redco_invocation_id="duplicate")
+
+    reservations = next(iter(api._scope_reservations.values()))
+    assert [item.provenance.spawn_ordinal for item in reservations] == [0, 1]
+    assert [
+        item.provenance.completed_predecessor_spawn_ordinals
+        for item in reservations
+    ] == [(), ()]
+    assert reservations[0].provenance.lineage != reservations[1].provenance.lineage
+
+    fast_result, slow_result = await asyncio.gather(fast, slow)
+    assert (fast_result.answer, slow_result.answer) == ("fast", "slow")
+    assert len(list((parent / ".redco-spawn-ordinals").glob("*.terminal"))) == 2
+
+
+async def test_sequential_spawn_snapshots_completed_predecessor(
+    tmp_path: Path,
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    _parent(tmp_path, monkeypatch)
+
+    await api.run("first")
+    await api.run("second")
+
+    reservations = next(iter(api._scope_reservations.values()))
+    assert reservations[0].provenance.completed_predecessor_spawn_ordinals == ()
+    assert reservations[1].provenance.completed_predecessor_spawn_ordinals == (0,)
+
+
+def test_recursive_explicit_session_bypass_is_rejected(
+    tmp_path: Path,
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    _parent(tmp_path, monkeypatch)
+    explicit = Session(tmp_path / "bypass")
+    try:
+        with pytest.raises(ValueError, match="cannot override"):
+            api.run("blocked", session=explicit)
+    finally:
+        explicit.close()
+
+
+def test_unawaited_ticket_is_durably_visible(
+    tmp_path: Path,
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    parent = _parent(tmp_path, monkeypatch)
+    coroutine = api.run("orphan")
+    coroutine.close()
+
+    ledger = parent / ".redco-spawn-ordinals"
+    assert len(list(ledger.glob("*.reserved"))) == 1
+    assert list(ledger.glob("*.terminal")) == []
+
+
+def test_terminal_write_failure_does_not_publish_completion(
+    tmp_path: Path,
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    _parent(tmp_path, monkeypatch)
+    orphan = api.run("orphan")
+    reservation = next(iter(api._scope_reservations.values()))[0]
+
+    def fail_terminal_write(*_args: object) -> None:
+        raise OSError("disk failure")
+
+    monkeypatch.setattr(Session, "mark_episode_spawn_terminal", fail_terminal_write)
+    with pytest.raises(OSError, match="disk failure"):
+        api._complete_child_spawn(reservation)
+    assert api._completed_spawns == set()
+    orphan.close()
+
+
+async def test_failure_and_cancellation_mark_tickets_terminal(
+    tmp_path: Path,
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    parent = _parent(tmp_path, monkeypatch)
+
+    with pytest.raises(RuntimeError, match="child failed"):
+        await api.run("fail")
+    waiting = asyncio.create_task(api.run("wait"))
+    await asyncio.sleep(0)
+    waiting.cancel()
+    with pytest.raises(asyncio.CancelledError):
+        await waiting
+
+    ledger = parent / ".redco-spawn-ordinals"
+    assert len(list(ledger.glob("*.terminal"))) == 2
+    assert next(iter(api._scope_reservations.values()))[
+        1
+    ].provenance.completed_predecessor_spawn_ordinals == (0,)
+    for session in _FakeEngine.sessions:
+        session.close()
+
+
+async def test_parent_tool_scope_resets_local_spawn_ordinal(
+    tmp_path: Path,
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    parent = _parent(tmp_path, monkeypatch)
+    await api.run("first")
+    with (parent / "messages.jsonl").open("a", encoding="utf-8") as handle:
+        handle.write(
+            json.dumps(
+                {
+                    "type": "assistant",
+                    "turn": 5,
+                    "session_call_ordinal": 8,
+                    "tool_calls": [{"id": "other-call", "name": "ipython"}],
+                }
+            )
+            + "\n"
+        )
+    await api.run("second")
+
+    assert sorted(
+        reservations[0].provenance.spawn_ordinal
+        for reservations in api._scope_reservations.values()
+    ) == [0, 0]
+
+
+async def test_completed_episode_ordinals_are_scoped_by_root_session(
+    tmp_path: Path,
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    _parent(tmp_path, monkeypatch)
+    await api.run("completed-in-first-root")
+
+    second_parent = tmp_path / "second-root-session"
+    second_parent.mkdir()
+    (second_parent / "messages.jsonl").write_text(
+        json.dumps(
+            {
+                "type": "assistant",
+                "turn": 4,
+                "session_call_ordinal": 7,
+                "tool_calls": [{"id": "generated-call", "name": "ipython"}],
+            }
+        )
+        + "\n",
+        encoding="utf-8",
+    )
+    monkeypatch.setenv("RLM_SESSION_DIR", str(second_parent))
+    monkeypatch.setenv("RLM_ROOT_SESSION_DIR", str(second_parent))
+
+    orphan = api.run("orphan-in-second-root")
+    second_scope = api._scope_reservations[
+        (str(second_parent.resolve()), 7, 0)
+    ]
+    assert second_scope[0].provenance.episode_spawn_ordinal == 0
+    assert second_scope[0].provenance.completed_predecessor_spawn_ordinals == ()
+    orphan.close()
+
+
+async def test_engine_assigns_session_call_ordinals_before_policy_requests(
+    session: Session,
+) -> None:
+    client = DummyClient([DummyMessage(content="first"), DummyMessage(content="second")])
+    engine = RLMEngine(client=client, session=session)  # type: ignore[arg-type]
+    try:
+        await engine.prompt("one")
+        await engine.prompt("two")
+    finally:
+        engine.close()
+
+    assert [call["extra_headers"]["X-RLM-Session-Call-Ordinal"] for call in client.calls] == [
+        "0",
+        "1",
+    ]
+
+
+async def test_engine_snapshots_durable_child_completions(
+    session: Session,
+) -> None:
+    ordinal = Session.reserve_episode_spawn_ordinal(session.root_session_dir)
+    Session.mark_episode_spawn_terminal(session.root_session_dir, ordinal)
+    client = DummyClient([DummyMessage(content="done")])
+    engine = RLMEngine(client=client, session=session)  # type: ignore[arg-type]
+    try:
+        await engine.prompt("one")
+    finally:
+        engine.close()
+
+    assert client.calls[0]["extra_headers"][
+        "X-RLM-Completed-Episode-Spawn-Ordinals"
+    ] == "0"
+
+
+async def test_retry_reuses_identical_session_call_ordinal(monkeypatch: pytest.MonkeyPatch) -> None:
+    from rlm import client
+
+    class TransientError(Exception):
+        pass
+
+    seen: list[str] = []
+
+    async def transient(**kwargs: Any) -> str:
+        seen.append(kwargs["extra_headers"]["X-RLM-Session-Call-Ordinal"])
+        if len(seen) < 3:
+            raise TransientError("transient")
+        return "ok"
+
+    async def no_sleep(_: float) -> None:
+        return None
+
+    monkeypatch.setattr(client.asyncio, "sleep", no_sleep)
+    monkeypatch.setattr(client, "_RETRYABLE", (TransientError,))
+    result = await call_with_retries(
+        transient,
+        extra_headers={"X-RLM-Session-Call-Ordinal": "5"},
+    )
+
+    assert result == "ok"
+    assert seen == ["5", "5", "5"]
