+    @staticmethod
+    def reserve_episode_spawn_ordinal(root_session_dir: Path) -> int:
+        """Atomically reserve one audit-only ordinal across nested processes."""
+        ledger = root_session_dir / ".redco-spawn-ordinals"
+        ledger.mkdir(parents=True, exist_ok=True)
+        ordinal = 0
+        while True:
+            reservation = ledger / f"{ordinal:012d}.reserved"
+            try:
+                with reservation.open("x", encoding="utf-8") as handle:
+                    handle.write("reserved\n")
+            except FileExistsError:
+                ordinal += 1
+                continue
+            return ordinal
+
+    @staticmethod
+    def mark_episode_spawn_terminal(root_session_dir: Path, ordinal: int) -> None:
+        """Durably distinguish completed tickets from orphaned/unawaited tickets."""
+        ledger = root_session_dir / ".redco-spawn-ordinals"
+        reserved = ledger / f"{ordinal:012d}.reserved"
+        if not reserved.exists():
+            raise RuntimeError("episode spawn reservation is missing")
+        terminal = ledger / f"{ordinal:012d}.terminal"
+        with terminal.open("x", encoding="utf-8") as handle:
+            handle.write("terminal\n")
+
+    @staticmethod
+    def completed_episode_spawn_ordinals(
+        root_session_dir: Path,
+    ) -> tuple[int, ...]:
+        """Snapshot durable completions before an outbound policy event."""
+        ledger = root_session_dir / ".redco-spawn-ordinals"
+        if not ledger.exists():
+            return ()
+        suffix = ".terminal"
+        names = sorted(path.name for path in ledger.glob(f"*{suffix}"))
+        if any(
+            len(name) != 12 + len(suffix)
+            or not name[:12].isdigit()
+            or name[12:] != suffix
+            for name in names
+        ):
+            raise RuntimeError("episode spawn terminal ledger is malformed")
+        return tuple(int(name[:12]) for name in names)
