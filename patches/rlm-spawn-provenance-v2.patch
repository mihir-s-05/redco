diff --git a/src/rlm/provenance.py b/src/rlm/provenance.py
new file mode 100644
index 0000000..47c70e8
--- /dev/null
+++ b/src/rlm/provenance.py
@@ -0,0 +1,214 @@
+"""Validated static provenance for one RLM session."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+from dataclasses import dataclass
+
+
+@dataclass(frozen=True, slots=True)
+class RLMProvenanceV2:
+    depth: int
+    lineage: str
+    parent_session_id: str | None = None
+    parent_turn: int | None = None
+    parent_tool_call_id: str | None = None
+    invocation_id: str | None = None
+    parent_lineage: str | None = None
+    parent_call_ordinal: int | None = None
+    parent_tool_call_slot: int | None = None
+    spawn_ordinal: int | None = None
+    episode_spawn_ordinal: int | None = None
+    completed_predecessor_spawn_ordinals: tuple[int, ...] = ()
+
+    def __post_init__(self) -> None:
+        if type(self.depth) is not int or self.depth < 0 or not _valid_text(self.lineage):
+            raise ValueError("RLM provenance depth and lineage are invalid")
+        recursive = (
+            self.parent_session_id,
+            self.parent_turn,
+            self.parent_tool_call_id,
+            self.invocation_id,
+            self.parent_lineage,
+            self.parent_call_ordinal,
+            self.parent_tool_call_slot,
+            self.spawn_ordinal,
+            self.episode_spawn_ordinal,
+        )
+        if self.depth == 0:
+            if self.lineage != "root" or any(value is not None for value in recursive):
+                raise ValueError("root RLM provenance contains recursive fields")
+            if self.completed_predecessor_spawn_ordinals:
+                raise ValueError("root RLM provenance contains predecessor ordinals")
+            return
+        required = (
+            self.parent_session_id,
+            self.parent_turn,
+            self.parent_tool_call_id,
+            self.parent_lineage,
+            self.parent_call_ordinal,
+            self.parent_tool_call_slot,
+            self.spawn_ordinal,
+            self.episode_spawn_ordinal,
+        )
+        if any(value is None for value in required):
+            raise ValueError("child RLM provenance is incomplete")
+        if not all(
+            _valid_text(value, max_length=128)
+            for value in (
+                self.parent_session_id,
+                self.parent_tool_call_id,
+                self.invocation_id,
+            )
+            if value is not None
+        ) or not _valid_text(self.parent_lineage):
+            raise ValueError("child RLM provenance text fields are invalid")
+        integer_values = (
+            self.parent_turn,
+            self.parent_call_ordinal,
+            self.parent_tool_call_slot,
+            self.spawn_ordinal,
+            self.episode_spawn_ordinal,
+        )
+        if any(type(value) is not int or value < 0 for value in integer_values):
+            raise ValueError("child RLM provenance ordinals must be nonnegative integers")
+        predecessors = self.completed_predecessor_spawn_ordinals
+        if predecessors != tuple(sorted(set(predecessors))) or any(
+            type(value) is not int or value < 0 or value >= self.spawn_ordinal
+            for value in predecessors
+        ):
+            raise ValueError("child RLM predecessor ordinals are invalid")
+        expected = self.derive_child_lineage(
+            parent_lineage=self.parent_lineage,
+            depth=self.depth,
+            parent_call_ordinal=self.parent_call_ordinal,
+            parent_tool_call_slot=self.parent_tool_call_slot,
+            spawn_ordinal=self.spawn_ordinal,
+        )
+        if self.lineage != expected:
+            raise ValueError("child RLM lineage does not match its structural coordinates")
+
+    @classmethod
+    def root(cls) -> RLMProvenanceV2:
+        return cls(depth=0, lineage="root")
+
+    @classmethod
+    def child(
+        cls,
+        *,
+        depth: int,
+        parent_session_id: str,
+        parent_turn: int,
+        parent_tool_call_id: str,
+        invocation_id: str | None,
+        parent_lineage: str,
+        parent_call_ordinal: int,
+        parent_tool_call_slot: int,
+        spawn_ordinal: int,
+        episode_spawn_ordinal: int,
+        completed_predecessor_spawn_ordinals: tuple[int, ...],
+    ) -> RLMProvenanceV2:
+        return cls(
+            depth=depth,
+            lineage=cls.derive_child_lineage(
+                parent_lineage=parent_lineage,
+                depth=depth,
+                parent_call_ordinal=parent_call_ordinal,
+                parent_tool_call_slot=parent_tool_call_slot,
+                spawn_ordinal=spawn_ordinal,
+            ),
+            parent_session_id=parent_session_id,
+            parent_turn=parent_turn,
+            parent_tool_call_id=parent_tool_call_id,
+            invocation_id=invocation_id,
+            parent_lineage=parent_lineage,
+            parent_call_ordinal=parent_call_ordinal,
+            parent_tool_call_slot=parent_tool_call_slot,
+            spawn_ordinal=spawn_ordinal,
+            episode_spawn_ordinal=episode_spawn_ordinal,
+            completed_predecessor_spawn_ordinals=(
+                completed_predecessor_spawn_ordinals
+            ),
+        )
+
+    @staticmethod
+    def derive_child_lineage(
+        *,
+        parent_lineage: str,
+        depth: int,
+        parent_call_ordinal: int,
+        parent_tool_call_slot: int,
+        spawn_ordinal: int,
+    ) -> str:
+        payload = json.dumps(
+            {
+                "domain": "redco.stage-d.spawn-lineage.v2",
+                "depth": depth,
+                "parent_lineage": parent_lineage,
+                "parent_call_ordinal": parent_call_ordinal,
+                "parent_tool_call_slot": parent_tool_call_slot,
+                "spawn_ordinal": spawn_ordinal,
+            },
+            sort_keys=True,
+            separators=(",", ":"),
+        ).encode("utf-8")
+        digest = hashlib.sha256(payload).hexdigest()[:24]
+        return f"{parent_lineage}/{digest}"
+
+    def headers(self, *, session_id: str) -> dict[str, str]:
+        if not _valid_text(session_id, max_length=128):
+            raise ValueError("RLM session id is invalid")
+        headers = {
+            "X-RLM-Depth": str(self.depth),
+            "X-RLM-Provenance-Version": "2",
+            "X-RLM-Session-ID": session_id,
+            "X-RLM-Lineage": self.lineage,
+        }
+        optional = {
+            "X-RLM-Parent-Session-ID": self.parent_session_id,
+            "X-RLM-Parent-Turn": self.parent_turn,
+            "X-RLM-Parent-Tool-Call-ID": self.parent_tool_call_id,
+            "X-RLM-Invocation-ID": self.invocation_id,
+            "X-RLM-Parent-Lineage": self.parent_lineage,
+            "X-RLM-Parent-Call-Ordinal": self.parent_call_ordinal,
+            "X-RLM-Parent-Tool-Call-Slot": self.parent_tool_call_slot,
+            "X-RLM-Spawn-Ordinal": self.spawn_ordinal,
+            "X-RLM-Episode-Spawn-Ordinal": self.episode_spawn_ordinal,
+        }
+        headers.update(
+            {name: str(value) for name, value in optional.items() if value is not None}
+        )
+        if self.completed_predecessor_spawn_ordinals:
+            headers["X-RLM-Completed-Predecessor-Spawn-Ordinals"] = ",".join(
+                str(value) for value in self.completed_predecessor_spawn_ordinals
+            )
+        return headers
+
+    def meta(self) -> dict[str, object]:
+        return {
+            "provenance_version": 2,
+            "depth": self.depth,
+            "lineage": self.lineage,
+            "parent_session_id": self.parent_session_id,
+            "parent_turn": self.parent_turn,
+            "parent_tool_call_id": self.parent_tool_call_id,
+            "invocation_id": self.invocation_id,
+            "parent_lineage": self.parent_lineage,
+            "parent_call_ordinal": self.parent_call_ordinal,
+            "parent_tool_call_slot": self.parent_tool_call_slot,
+            "spawn_ordinal": self.spawn_ordinal,
+            "episode_spawn_ordinal": self.episode_spawn_ordinal,
+            "completed_predecessor_spawn_ordinals": (
+                self.completed_predecessor_spawn_ordinals
+            ),
+        }
+
+
+def _valid_text(value: object, *, max_length: int = 512) -> bool:
+    return (
+        isinstance(value, str)
+        and bool(value)
+        and len(value) <= max_length
+        and value.isprintable()
+    )
