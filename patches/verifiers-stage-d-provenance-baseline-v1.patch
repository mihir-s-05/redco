+        except ValueError:
+            return None
+        return parsed if parsed >= 0 else None
+
+    call_kind = text("X-RLM-Call-Kind")
+    if call_kind not in {"policy", "compaction"}:
+        call_kind = None
+    values = {
+        "provenance_version": None,
+        "depth": integer("X-RLM-Depth"),
+        "session_id": text("X-RLM-Session-ID"),
+        "turn": integer("X-RLM-Turn"),
+        "call_kind": call_kind,
+        "parent_session_id": text("X-RLM-Parent-Session-ID"),
+        "parent_turn": integer("X-RLM-Parent-Turn"),
+        "parent_tool_call_id": text("X-RLM-Parent-Tool-Call-ID"),
+        "invocation_id": text("X-RLM-Invocation-ID"),
+    }
+    if all(value is None for value in values.values()):
+        return None
+    return RLMCallStructure.model_validate(values)
