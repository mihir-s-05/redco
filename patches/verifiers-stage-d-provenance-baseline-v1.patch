diff --git a/verifiers/v1/rlm_provenance.py b/verifiers/v1/rlm_provenance.py
new file mode 100644
index 000000000..6b43265a1
--- /dev/null
+++ b/verifiers/v1/rlm_provenance.py
@@ -0,0 +1,272 @@
+"""Versioned RLM header parsing, isolated from interception orchestration."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+from collections.abc import Mapping
+
+from verifiers.v1.trace import RLMCallStructure
+
+
+def parse_rlm_structure(
+    headers: Mapping[str, str] | None,
+) -> RLMCallStructure | None:
+    if headers is None:
+        return None
+    version = headers.get("X-RLM-Provenance-Version")
+    if version is None:
+        return _parse_v1(headers)
+    if version != "2":
+        raise ValueError("X-RLM-Provenance-Version must be exactly 2")
+    return _parse_v2(headers)
+
+
+def request_operation_key(
+    body_digest: bytes,
+    structure: RLMCallStructure | None,
+) -> bytes:
+    """Namespace retry identity by the validated v2 scientific event address."""
+    if structure is None or structure.provenance_version != 2:
+        return body_digest
+    if (
+        structure.lineage is None
+        or structure.session_call_ordinal is None
+        or structure.call_kind is None
+    ):
+        raise ValueError("incomplete v2 scientific event address")
+    address = json.dumps(
+        {
+            "lineage": structure.lineage,
+            "session_call_ordinal": structure.session_call_ordinal,
+            "call_kind": structure.call_kind,
+        },
+        sort_keys=True,
+        separators=(",", ":"),
+    ).encode("utf-8")
+    return hashlib.blake2b(
+        body_digest + b"\0" + address,
+        digest_size=16,
+        person=b"rlm-retry-v2",
+    ).digest()
+
+
+def _parse_v2(headers: Mapping[str, str]) -> RLMCallStructure:
+    def required_text(
+        name: str,
+        *,
+        max_length: int = 512,
+        allow_empty: bool = False,
+    ) -> str:
+        value = headers.get(name)
+        if value is None:
+            raise ValueError(f"missing {name}")
+        normalized = value.strip()
+        if (
+            (not normalized and not allow_empty)
+            or len(normalized) > max_length
+            or not normalized.isprintable()
+        ):
+            raise ValueError(f"invalid {name}")
+        return normalized
+
+    def optional_text(name: str, *, max_length: int = 512) -> str | None:
+        value = headers.get(name)
+        if value is None:
+            return None
+        normalized = value.strip()
+        if (
+            not normalized
+            or len(normalized) > max_length
+            or not normalized.isprintable()
+        ):
+            raise ValueError(f"invalid {name}")
+        return normalized
+
+    def required_integer(name: str) -> int:
+        value = required_text(name)
+        try:
+            parsed = int(value)
+        except ValueError as error:
+            raise ValueError(f"invalid {name}") from error
+        if parsed < 0 or str(parsed) != value:
+            raise ValueError(f"invalid {name}")
+        return parsed
+
+    depth = required_integer("X-RLM-Depth")
+    call_kind = required_text("X-RLM-Call-Kind")
+    if call_kind not in {"policy", "compaction"}:
+        raise ValueError("invalid X-RLM-Call-Kind")
+    lineage = required_text("X-RLM-Lineage")
+    values: dict[str, object] = {
+        "provenance_version": 2,
+        "depth": depth,
+        "session_id": required_text("X-RLM-Session-ID", max_length=128),
+        "lineage": lineage,
+        "session_call_ordinal": required_integer(
+            "X-RLM-Session-Call-Ordinal"
+        ),
+        "turn": required_integer("X-RLM-Turn"),
+        "call_kind": call_kind,
+        "completed_episode_spawn_ordinals": _ordinal_list(
+            required_text(
+                "X-RLM-Completed-Episode-Spawn-Ordinals",
+                max_length=8192,
+                allow_empty=True,
+            ),
+            label="completed episode spawn ordinals",
+        ),
+    }
+    recursive_names = (
+        "X-RLM-Parent-Session-ID",
+        "X-RLM-Parent-Turn",
+        "X-RLM-Parent-Tool-Call-ID",
+        "X-RLM-Invocation-ID",
+        "X-RLM-Parent-Lineage",
+        "X-RLM-Parent-Call-Ordinal",
+        "X-RLM-Parent-Tool-Call-Slot",
+        "X-RLM-Spawn-Ordinal",
+        "X-RLM-Episode-Spawn-Ordinal",
+        "X-RLM-Completed-Predecessor-Spawn-Ordinals",
+    )
+    if depth == 0:
+        if lineage != "root":
+            raise ValueError("root RLM lineage must be root")
+        if any(headers.get(name) is not None for name in recursive_names):
+            raise ValueError("root RLM provenance contains recursive headers")
+        return RLMCallStructure.model_validate(values)
+
+    spawn_ordinal = required_integer("X-RLM-Spawn-Ordinal")
+    predecessors = _predecessors(headers, spawn_ordinal=spawn_ordinal)
+    parent_lineage = required_text("X-RLM-Parent-Lineage")
+    parent_call_ordinal = required_integer("X-RLM-Parent-Call-Ordinal")
+    parent_tool_call_slot = required_integer("X-RLM-Parent-Tool-Call-Slot")
+    expected_lineage = derive_child_lineage(
+        parent_lineage=parent_lineage,
+        depth=depth,
+        parent_call_ordinal=parent_call_ordinal,
+        parent_tool_call_slot=parent_tool_call_slot,
+        spawn_ordinal=spawn_ordinal,
+    )
+    if lineage != expected_lineage:
+        raise ValueError("RLM lineage does not match its structural coordinates")
+    values.update(
+        {
+            "parent_session_id": required_text(
+                "X-RLM-Parent-Session-ID", max_length=128
+            ),
+            "parent_turn": required_integer("X-RLM-Parent-Turn"),
+            "parent_tool_call_id": required_text(
+                "X-RLM-Parent-Tool-Call-ID", max_length=128
+            ),
+            "invocation_id": optional_text(
+                "X-RLM-Invocation-ID", max_length=128
+            ),
+            "parent_lineage": parent_lineage,
+            "parent_call_ordinal": parent_call_ordinal,
+            "parent_tool_call_slot": parent_tool_call_slot,
+            "spawn_ordinal": spawn_ordinal,
+            "episode_spawn_ordinal": required_integer(
+                "X-RLM-Episode-Spawn-Ordinal"
+            ),
+            "completed_predecessor_spawn_ordinals": predecessors,
+        }
+    )
+    return RLMCallStructure.model_validate(values)
+
+
+def _predecessors(
+    headers: Mapping[str, str],
+    *,
+    spawn_ordinal: int,
+) -> tuple[int, ...]:
+    value = headers.get("X-RLM-Completed-Predecessor-Spawn-Ordinals")
+    if value is None:
+        return ()
+    predecessors = _ordinal_list(value, label="predecessor spawn ordinals")
+    if predecessors != tuple(sorted(set(predecessors))) or any(
+        predecessor >= spawn_ordinal for predecessor in predecessors
+    ):
+        raise ValueError("invalid predecessor spawn ordinals")
+    return predecessors
+
+
+def _ordinal_list(value: str, *, label: str) -> tuple[int, ...]:
+    if value == "":
+        return ()
+    parts = value.split(",")
+    if any(not raw or not raw.isdecimal() for raw in parts):
+        raise ValueError(f"invalid {label}")
+    parsed = tuple(int(raw) for raw in parts)
+    if any(
+        str(ordinal) != raw
+        for ordinal, raw in zip(parsed, parts, strict=True)
+    ) or parsed != tuple(sorted(set(parsed))):
+        raise ValueError(f"invalid {label}")
+    return parsed
+
+
+def derive_child_lineage(
+    *,
+    parent_lineage: str,
+    depth: int,
+    parent_call_ordinal: int,
+    parent_tool_call_slot: int,
+    spawn_ordinal: int,
+) -> str:
+    """Recompute the producer's stable lineage at the interception boundary."""
+    payload = json.dumps(
+        {
+            "domain": "redco.stage-d.spawn-lineage.v2",
+            "depth": depth,
+            "parent_lineage": parent_lineage,
+            "parent_call_ordinal": parent_call_ordinal,
+            "parent_tool_call_slot": parent_tool_call_slot,
+            "spawn_ordinal": spawn_ordinal,
