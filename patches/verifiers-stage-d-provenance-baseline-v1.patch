+++ b/tests/test_rlm_structure_v2.py
@@ -0,0 +1,236 @@
+from __future__ import annotations
+
+import json
+from types import SimpleNamespace
+from unittest.mock import AsyncMock
+
+import pytest
+from multidict import CIMultiDict
+from verifiers.v1.clients import ModelContext
+from verifiers.v1.dialects.chat import ChatDialect
+from verifiers.v1.interception.server import InterceptionServer, _rlm_structure
+from verifiers.v1.rlm_provenance import (
+    derive_child_lineage,
+    request_operation_key,
+)
+from verifiers.v1.session import RolloutSession
+from verifiers.v1.task import TaskData
+from verifiers.v1.trace import Trace, TraceTask
+from verifiers.v1.types import AssistantMessage, Response
+
+_GOLDEN_CHILD_LINEAGE = "root/7ef6d951f46aae83454a5964"
+
+
+def _child_headers() -> dict[str, str]:
+    return {
+        "X-RLM-Provenance-Version": "2",
+        "X-RLM-Depth": "1",
+        "X-RLM-Session-ID": "generated-child",
+        "X-RLM-Lineage": _GOLDEN_CHILD_LINEAGE,
+        "X-RLM-Session-Call-Ordinal": "0",
+        "X-RLM-Turn": "0",
+        "X-RLM-Call-Kind": "policy",
+        "X-RLM-Completed-Episode-Spawn-Ordinals": "0,1",
+        "X-RLM-Parent-Session-ID": "generated-root",
+        "X-RLM-Parent-Turn": "2",
+        "X-RLM-Parent-Tool-Call-ID": "generated-tool-call",
+        "X-RLM-Invocation-ID": "diagnostic-label",
+        "X-RLM-Parent-Lineage": "root",
+        "X-RLM-Parent-Call-Ordinal": "3",
+        "X-RLM-Parent-Tool-Call-Slot": "0",
+        "X-RLM-Spawn-Ordinal": "2",
+        "X-RLM-Episode-Spawn-Ordinal": "8",
+        "X-RLM-Completed-Predecessor-Spawn-Ordinals": "0,1",
+    }
+
+
+def _sibling_headers(spawn_ordinal: int) -> dict[str, str]:
+    headers = _child_headers()
+    headers["X-RLM-Spawn-Ordinal"] = str(spawn_ordinal)
+    headers["X-RLM-Episode-Spawn-Ordinal"] = str(8 + spawn_ordinal)
+    headers["X-RLM-Completed-Predecessor-Spawn-Ordinals"] = ",".join(
+        str(ordinal) for ordinal in range(spawn_ordinal)
+    )
+    headers["X-RLM-Lineage"] = derive_child_lineage(
+        parent_lineage="root",
+        depth=1,
+        parent_call_ordinal=3,
+        parent_tool_call_slot=0,
+        spawn_ordinal=spawn_ordinal,
+    )
+    return headers
+
+
+def test_v2_child_headers_match_the_producer_golden_vector() -> None:
+    structure = _rlm_structure(_child_headers())
+
+    assert structure is not None
+    assert structure.provenance_version == 2
+    assert structure.lineage == _GOLDEN_CHILD_LINEAGE
+    assert structure.session_call_ordinal == 0
+    assert structure.spawn_ordinal == 2
+    assert structure.completed_predecessor_spawn_ordinals == (0, 1)
+    assert structure.completed_episode_spawn_ordinals == (0, 1)
+
+
+def test_v2_root_rejects_recursive_fields() -> None:
+    headers = {
+        "X-RLM-Provenance-Version": "2",
+        "X-RLM-Depth": "0",
+        "X-RLM-Session-ID": "generated-root",
+        "X-RLM-Lineage": "root",
+        "X-RLM-Session-Call-Ordinal": "0",
+        "X-RLM-Turn": "0",
+        "X-RLM-Call-Kind": "policy",
+        "X-RLM-Completed-Episode-Spawn-Ordinals": "",
+        "X-RLM-Spawn-Ordinal": "0",
+    }
+
+    with pytest.raises(ValueError, match="recursive headers"):
+        _rlm_structure(headers)
+
+
+@pytest.mark.parametrize(
+    ("name", "value"),
+    [
+        ("X-RLM-Lineage", None),
+        ("X-RLM-Lineage", "root/not-the-structural-lineage"),
+        ("X-RLM-Session-Call-Ordinal", "01"),
+        ("X-RLM-Completed-Episode-Spawn-Ordinals", "0,0"),
+        ("X-RLM-Completed-Predecessor-Spawn-Ordinals", "0,0"),
+        ("X-RLM-Completed-Predecessor-Spawn-Ordinals", "0,2"),
+        ("X-RLM-Parent-Call-Ordinal", "-1"),
+    ],
+)
+def test_v2_partial_or_malformed_headers_fail_closed(
+    name: str,
+    value: str | None,
+) -> None:
+    headers = _child_headers()
+    if value is None:
+        del headers[name]
+    else:
+        headers[name] = value
+
+    with pytest.raises(ValueError):
+        _rlm_structure(headers)
+
+
+def test_generated_diagnostic_ids_do_not_change_scientific_coordinates() -> None:
+    first = _rlm_structure(_child_headers())
+    changed = _child_headers()
+    changed["X-RLM-Session-ID"] = "other-session"
+    changed["X-RLM-Parent-Session-ID"] = "other-parent"
+    changed["X-RLM-Parent-Tool-Call-ID"] = "other-tool"
+    changed["X-RLM-Invocation-ID"] = "other-label"
+    second = _rlm_structure(changed)
+
+    assert first is not None and second is not None
+    assert (
+        first.lineage,
+        first.session_call_ordinal,
+        first.call_kind,
+    ) == (
+        second.lineage,
+        second.session_call_ordinal,
+        second.call_kind,
+    )
+
+
+async def test_malformed_v2_is_rejected_before_any_upstream_access() -> None:
+    server = InterceptionServer()
+    server.sessions["secret"] = SimpleNamespace()
+    headers = _child_headers()
+    headers["Authorization"] = "Bearer secret"
+    headers["X-RLM-Lineage"] = "root/malformed"
+    request = SimpleNamespace(headers=headers)
+    dialect = SimpleNamespace(
+        secret=lambda received: "secret",
+        error_body=lambda message: {"error": message},
+    )
+
+    response = await server.handle_request(request, dialect)
+
+    assert response.status == 400
+
+
+def test_v2_operation_key_separates_siblings_but_coalesces_exact_retry() -> None:
+    body_digest = b"same-body-digest"
+    first = _rlm_structure(_sibling_headers(2))
+    second = _rlm_structure(_sibling_headers(3))
+
+    assert request_operation_key(body_digest, first) == request_operation_key(
+        body_digest, first
+    )
+    assert request_operation_key(body_digest, first) != request_operation_key(
+        body_digest, second
+    )
+    assert request_operation_key(body_digest, None) == body_digest
+
+
+async def test_handler_replays_delayed_retry_without_coalescing_sibling() -> None:
+    calls = 0
+
+    async def get_response(*args, **kwargs) -> Response:
+        nonlocal calls
+        calls += 1
+        content = f"result-{calls}"
+        raw = {
+            "id": f"completion-{calls}",
+            "object": "chat.completion",
+            "created": calls,
+            "model": "test-model",
+            "choices": [
+                {
+                    "index": 0,
+                    "message": {"role": "assistant", "content": content},
+                    "finish_reason": "stop",
+                }
+            ],
+        }
+        return Response(
+            id=f"completion-{calls}",
+            created=calls,
+            model="test-model",
+            message=AssistantMessage(content=content),
+            finish_reason="stop",
+            raw=raw,
+        )
+
+    client = SimpleNamespace(get_response=AsyncMock(side_effect=get_response))
+    trace = Trace(
+        task=TraceTask(type="RetryIdentityTask", data=TaskData(prompt="hello"))
+    )
+    session = RolloutSession(ModelContext("test-model", client), trace)
+    server = InterceptionServer()
+    server.sessions["secret"] = session
+    dialect = ChatDialect()
+    raw = json.dumps(
+        {
+            "model": "ignored",
+            "messages": [{"role": "user", "content": "hello"}],
+        },
+        separators=(",", ":"),
+    ).encode()
+
+    def request(headers: dict[str, str]) -> SimpleNamespace:
+        wire_headers = CIMultiDict(headers)
+        wire_headers["Authorization"] = "Bearer secret"
+        return SimpleNamespace(
+            headers=wire_headers,
+            path="/v1/chat/completions",
+            read=AsyncMock(return_value=raw),
+            _read_bytes=raw,
+        )
+
+    first_headers = _sibling_headers(2)
+    await server.handle_request(request(first_headers), dialect)
+    await server.handle_request(request(_sibling_headers(3)), dialect)
+    await server.handle_request(request(first_headers), dialect)
+
+    assert calls == 2
+    assert len(trace.calls) == 2
+    assert [call.rlm.lineage for call in trace.calls if call.rlm is not None] == [
+        _sibling_headers(2)["X-RLM-Lineage"],
+        _sibling_headers(3)["X-RLM-Lineage"],
+    ]
