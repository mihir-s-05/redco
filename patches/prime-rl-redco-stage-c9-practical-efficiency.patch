+
+def test_redco_supports_eleven_branch_power_analysis_group():
+    group: list[Rollout] = []
+    reward_groups = (
+        tuple(float(index == 5) for index in range(11)),
+        tuple(float(index in {2, 5}) for index in range(11)),
+    )
+    for episode_index, rewards in enumerate(reward_groups):
+        context = _make_rollout(rewards[0], completion_len=2)
+        context.episode_id = f"episode-{episode_index}"
+        context.policy_version = 7
+        context.info["redco"] = {
+            "record_kind": "context",
+            "target_node_id": "subcall-0",
+            "selected_pre_action": True,
+            "replay_mode": "sliced",
+            "replay_equivalent": True,
+        }
+        group.append(context)
+        for branch_index, reward in enumerate(rewards):
+            rollout = _make_rollout(reward, completion_len=2)
+            rollout.episode_id = f"episode-{episode_index}"
+            rollout.policy_version = 7
+            rollout.info["redco"] = {
+                "record_kind": "branch",
+                "branch_index": branch_index,
+                "action_source": "original" if branch_index == 0 else "sampled",
+                "target_node_id": "subcall-0",
+                "selected_pre_action": True,
+                "replay_mode": "sliced",
+                "replay_equivalent": True,
+            }
+            group.append(rollout)
+
+    algorithm = RedcoAlgorithm(
+        RedcoAlgoConfig(branch_group_size=11),
+        policy_pool=None,
+    )
+    asyncio.run(algorithm.finalize_group(group))
+
+    for episode_index, rewards in enumerate(reward_groups):
+        episode = group[episode_index * 12 : (episode_index + 1) * 12]
+        _, *branches = episode
+        expected = [
+            reward - (sum(rewards) - reward) / (len(rewards) - 1)
