+        for rollout, advantage in zip(branches, expected, strict=True):
+            sample = rollout.samples[0]
+            assert sample.advantages == pytest.approx([0.0, advantage, advantage])
+            assert sample.rl_weights == [0.0, 1.0 / 11.0, 1.0 / 11.0]
+            assert sample.rl_normalizer == pytest.approx(1.0 / 11.0)
