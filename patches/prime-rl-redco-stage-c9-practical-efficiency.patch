+    for episode_index, rewards in enumerate(reward_groups):
+        context = _make_rollout(rewards[0], completion_len=1)
+        context.episode_id = f"episode-{episode_index}"
+        context.policy_version = 7
+        context.info["redco"] = {
+            "record_kind": "context",
+            "target_node_id": "subcall-0",
+            "selected_pre_action": True,
+            "replay_mode": "sliced",
+            "replay_equivalent": True,
+        }
+        group.append(context)
+        for branch_index, reward in enumerate(rewards):
+            rollout = _make_rollout(reward, completion_len=1)
+            rollout.episode_id = context.episode_id
+            rollout.policy_version = 7
+            rollout.info["redco"] = {
+                "record_kind": "branch",
+                "branch_index": branch_index,
+                "action_source": "original" if branch_index == 0 else "sampled",
+                "target_node_id": "subcall-0",
+                "selected_pre_action": True,
+                "replay_mode": "sliced",
+                "replay_equivalent": True,
+            }
+            group.append(rollout)
+
+    algorithm = RedcoAlgorithm(
+        RedcoAlgoConfig(branch_credit_scope="global_loo"),
+        policy_pool=None,
+    )
+    asyncio.run(algorithm.finalize_group(group))
+
+    rewards = tuple(value for episode in reward_groups for value in episode)
+    expected = [
+        reward - (sum(rewards) - reward) / (len(rewards) - 1)
+        for reward in rewards
+    ]
+    observed = [
+        rollout.samples[0].advantages[-1]
+        for rollout in group
+        if rollout.info["redco"]["record_kind"] == "branch"
+    ]
+    assert observed == pytest.approx(expected)
+
+
+def test_redco_rejects_singleton_trajectory_group_explicitly():
+    context = _make_rollout(1.0, completion_len=2)
+    context.episode_id = "episode-0"
+    context.info["redco"] = {
+        "record_kind": "context",
+        "target_node_id": "subcall-0",
+        "selected_pre_action": True,
+        "replay_mode": "sliced",
+        "replay_equivalent": True,
+    }
+    group = [context]
