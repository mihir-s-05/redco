+def apply_exact_categorical_normalization(
+    scaled_logits: Tensor,
+    labels: Tensor,
+    trainer_logprobs: Tensor,
+    entropy: Tensor,
+    token_groups: list[list[int]],
+) -> tuple[Tensor, Tensor, Tensor]:
+    """Replace member-token likelihoods with exact finite-action likelihoods.
+
+    ``scaled_logits`` are already divided by the per-token behavior
+    temperature. For a label in group ``G``, this computes
+
+    ``log pi_G(a|s) = z_a - logsumexp({z_b: b in G})``.
+
+    The operation retains autograd through both the selected action logit and
+    the group normalizer. Labels outside every configured group preserve the
+    ordinary full-vocabulary likelihood and entropy.
+    """
+    if scaled_logits.ndim != 3:
+        raise ValueError("scaled_logits must have shape [batch, seq, vocab]")
+    if labels.shape != scaled_logits.shape[:2]:
+        raise ValueError("labels must match the batch and sequence dimensions")
+    if trainer_logprobs.shape != labels.shape or entropy.shape != labels.shape:
+        raise ValueError("logprob and entropy tensors must match labels")
+
+    normalized_logprobs = trainer_logprobs
+    normalized_entropy = entropy
+    normalized_mask = torch.zeros_like(labels, dtype=torch.bool)
+    vocab_size = scaled_logits.shape[-1]
+    seen: set[int] = set()
+    for group in token_groups:
+        if not group:
+            raise ValueError("exact categorical token groups cannot be empty")
+        if min(group) < 0 or max(group) >= vocab_size:
+            raise ValueError(
+                f"exact categorical token id lies outside vocabulary size {vocab_size}"
+            )
+        overlap = seen.intersection(group)
+        if overlap:
+            raise ValueError(
+                "exact categorical token groups must be disjoint; "
+                f"overlap={sorted(overlap)}"
+            )
+        seen.update(group)
+        allowed = torch.tensor(group, dtype=torch.long, device=labels.device)
+        matches = labels.unsqueeze(-1) == allowed
+        group_mask = matches.any(dim=-1)
+
+        group_logits = scaled_logits.index_select(-1, allowed).float()
+        group_logprobs = group_logits - torch.logsumexp(
+            group_logits, dim=-1, keepdim=True
+        )
+        selected_logprobs = torch.where(
+            matches,
+            group_logprobs,
+            torch.zeros_like(group_logprobs),
+        ).sum(dim=-1)
+        group_probabilities = group_logprobs.exp()
+        group_entropy = -(
+            group_probabilities * group_logprobs
+        ).sum(dim=-1)
+
+        normalized_logprobs = torch.where(
+            group_mask,
+            selected_logprobs,
+            normalized_logprobs,
+        )
+        normalized_entropy = torch.where(
+            group_mask,
+            group_entropy,
+            normalized_entropy,
+        )
+        normalized_mask = normalized_mask | group_mask
+
+    return normalized_logprobs, normalized_entropy, normalized_mask
+
+
