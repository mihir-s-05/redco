+def test_clipped_node_loss_uses_one_sequence_ratio_and_one_node_weight():
+    inputs = LossInputs(
+        trainer_logprobs=torch.tensor([-0.1, -0.2]),
+        inference_logprobs=torch.tensor([-0.2, -0.4]),
+        ref_logprobs=None,
+        advantages=torch.tensor([2.0, 2.0]),
+        loss_mask=torch.tensor([True, True]),
+        loss_weights=torch.tensor([0.25, 0.25]),
+    )
+
+    result = clipped_node_loss(
+        inputs,
+        clip_epsilon=0.2,
+        kl_tau=0.0,
+        ratio_mode="exact_sequence",
+    )
+
+    assert result.loss.item() == pytest.approx(-0.25 * 2.0 * 1.2)
+    assert result.metrics["redco_node_clipped"].item() == 1.0
+    assert result.metrics["redco_node_log_ratio"].item() == pytest.approx(0.3)
+    assert result.metrics["redco_node_sampled_kl"].item() == pytest.approx(-0.3)
+    assert result.metrics["redco_node_squared_log_ratio"].item() == pytest.approx(
+        0.09
+    )
+
+
+def test_clipped_node_loss_supports_geometric_mean_ratio():
+    inputs = LossInputs(
+        trainer_logprobs=torch.tensor([-0.1, -0.2]),
+        inference_logprobs=torch.tensor([-0.2, -0.4]),
+        ref_logprobs=None,
+        advantages=torch.tensor([-1.0, -1.0]),
+        loss_mask=torch.tensor([True, True]),
+        loss_weights=torch.tensor([1.0, 1.0]),
+    )
+
+    result = clipped_node_loss(
+        inputs,
+        clip_epsilon=0.2,
+        kl_tau=0.0,
+        ratio_mode="geometric_mean",
+    )
+
+    assert result.metrics["redco_node_ratio"].item() == pytest.approx(
+        torch.exp(torch.tensor(0.15)).item()
+    )
+    assert result.metrics["redco_node_clipped"].item() == 0.0
