index 000000000..9a95a9356
--- /dev/null
+++ b/src/prime_rl/trainer/rl/redco_loss.py
@@ -0,0 +1,110 @@
+from __future__ import annotations
+
+import torch
+
+from prime_rl.trainer.rl.loss import (
+    LossInputs,
+    LossOutputs,
+    compute_importance_ratio_and_mismatch_kl,
+)
+
+
+def clean_decision_loss(
+    inputs: LossInputs,
+    *,
+    kl_tau: float = 1e-3,
+) -> LossOutputs:
+    """Near-on-policy node-summed REINFORCE with a separate KL penalty."""
+    if inputs.loss_weights is None:
+        raise ValueError("clean decision loss requires explicit RL weights")
+    mask = inputs.loss_mask
+    weights = inputs.loss_weights
+    log_ratio, _, mismatch_kl = compute_importance_ratio_and_mismatch_kl(
+        inputs.trainer_logprobs,
+        inputs.inference_logprobs,
+    )
+    policy_gradient = -(
+        inputs.advantages * inputs.trainer_logprobs * weights
+    )[mask].sum()
+    kl = (log_ratio.square() * weights)[mask].sum()
+    return LossOutputs(
+        loss=policy_gradient + kl_tau * kl,
+        metrics={
+            "redco_decision_pg": policy_gradient.detach(),
+            "redco_decision_kl": kl.detach(),
+            "redco_mismatch_kl": (
+                mismatch_kl[mask].mean()
+                if bool(mask.any())
+                else torch.zeros((), device=mask.device)
+            ),
+        },
+    )
+
+
+def clipped_node_loss(
+    inputs: LossInputs,
+    *,
+    clip_epsilon: float = 0.2,
+    kl_tau: float = 1e-3,
+    ratio_mode: str = "exact_sequence",
+) -> LossOutputs:
+    """PPO-style clipped surrogate over one complete policy decision."""
+    if inputs.loss_weights is None:
+        raise ValueError("clipped node loss requires explicit RL weights")
+    if not 0.0 < clip_epsilon < 1.0:
+        raise ValueError("clip_epsilon must be in (0, 1)")
+    mask = inputs.loss_mask
+    if not bool(mask.any()):
+        zero = inputs.trainer_logprobs.sum() * 0.0
+        return LossOutputs(
+            loss=zero,
+            metrics={
+                "redco_node_ratio": zero.detach(),
+                "redco_node_log_ratio": zero.detach(),
+                "redco_node_clipped": zero.detach(),
+                "redco_node_sampled_kl": zero.detach(),
+                "redco_node_squared_log_ratio": zero.detach(),
+            },
+        )
+    advantages = inputs.advantages[mask]
+    if not torch.allclose(advantages, advantages[0].expand_as(advantages)):
+        raise ValueError("one node sequence must carry one scalar advantage")
+    weights = inputs.loss_weights[mask]
+    if not torch.allclose(weights, weights[0].expand_as(weights)):
+        raise ValueError("one node sequence must carry one decision-unit weight")
+
+    token_log_ratios = (
+        inputs.trainer_logprobs[mask] - inputs.inference_logprobs[mask]
+    )
+    if ratio_mode == "exact_sequence":
+        node_log_ratio = token_log_ratios.sum()
+    elif ratio_mode == "geometric_mean":
+        node_log_ratio = token_log_ratios.mean()
+    else:
+        raise ValueError(
+            "ratio_mode must be 'exact_sequence' or 'geometric_mean'"
+        )
+    ratio = node_log_ratio.exp()
+    clipped_ratio = ratio.clamp(1.0 - clip_epsilon, 1.0 + clip_epsilon)
+    advantage = advantages[0]
+    surrogate = torch.minimum(ratio * advantage, clipped_ratio * advantage)
+    node_weight = weights[0]
+    squared_log_ratio = node_log_ratio.square()
+    loss = node_weight * (-surrogate + kl_tau * squared_log_ratio)
+    clipped = (
+        ((advantage >= 0) & (ratio > 1.0 + clip_epsilon))
+        | ((advantage < 0) & (ratio < 1.0 - clip_epsilon))
+    ).to(ratio.dtype)
+    return LossOutputs(
+        loss=loss,
+        metrics={
+            "redco_node_ratio": ratio.detach(),
+            "redco_node_log_ratio": node_log_ratio.detach(),
+            "redco_node_clipped": clipped.detach(),
+            # One behavior-policy sample of log pi_b - log pi_theta. The
+            # expectation under pi_b is KL(pi_b || pi_theta); individual
+            # samples may be signed.
+            "redco_node_sampled_kl": (-node_log_ratio).detach(),
+            "redco_node_squared_log_ratio": squared_log_ratio.detach(),
+        },
+    )
