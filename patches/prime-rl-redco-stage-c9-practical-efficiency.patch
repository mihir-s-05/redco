+            "selected_pre_action": True,
+            "replay_mode": "sliced",
+            "replay_equivalent": True,
+        }
+        group.append(rollout)
+
+    algorithm = RedcoAlgorithm(RedcoAlgoConfig(), policy_pool=None)
+    with pytest.raises(ValueError, match="at least two complete episodes"):
+        asyncio.run(algorithm.finalize_group(group))
