+class _PreparedObserver:
+    def __init__(self):
+        self.events = []
+
+    async def before_forward(self, prepared):
+        assert isinstance(prepared, PreparedGenerateRequest)
+        self.events.append(("before", prepared))
+        return "ticket"
+
+    async def after_response(self, ticket, response):
+        self.events.append(("after", ticket, response))
+
+    async def abort(self, ticket, phase, error):
+        self.events.append(("abort", ticket, phase, type(error).__name__))
+
+
+def _observed_generate(client, observer):
+    return generate(
+        client=client,
+        renderer=_FakeRenderer(),
+        messages=[{"role": "user", "content": "hi"}],
+        model="test-model",
+        tools=[{"type": "function", "function": {"name": "echo"}}],
+        sampling_params={"temperature": 0.3, "max_tokens": 7},
+        effective_request={"model": "test-model", "messages": []},
+        observer_context={"trace_id": "trace-1", "rlm": {"depth": 0}},
+        observer=observer,
+    )
+
+
+def test_prepared_observer_runs_before_exactly_one_post():
+    client = _FakeClient()
+    observer = _PreparedObserver()
+    result = asyncio.run(_observed_generate(client, observer))
+
+    assert len(client.calls) == 1
+    assert [event[0] for event in observer.events] == ["before"]
+    prepared = observer.events[0][1]
+    assert json.loads(prepared.application_request) == {
+        "messages": [],
+        "model": "test-model",
+    }
+    assert json.loads(prepared.engine_request)["token_ids"] == [1, 2, 3]
+    assert prepared.prompt_token_ids == (1, 2, 3)
+    assert result.pop("_prepared_observation_ticket") == "ticket"
+
+
+def test_prepared_observer_aborts_unknown_post_outcome():
+    class FailingClient(_FakeClient):
+        async def post(self, *args, **kwargs):
+            raise ConnectionError("unknown delivery")
+
+    observer = _PreparedObserver()
+    with pytest.raises(ConnectionError, match="unknown delivery"):
+        asyncio.run(_observed_generate(FailingClient(), observer))
+    assert [event[0] for event in observer.events] == ["before", "abort"]
+    assert observer.events[-1][2:] == ("post_unknown", "ConnectionError")
+
+
+def test_prepared_observer_durably_aborts_cancelled_post():
+    class BlockingClient(_FakeClient):
+        def __init__(self):
+            super().__init__()
+            self.started = asyncio.Event()
+
+        async def post(self, *args, **kwargs):
+            self.started.set()
+            await asyncio.Event().wait()
+
+    async def exercise():
+        client = BlockingClient()
+        observer = _PreparedObserver()
+        task = asyncio.create_task(_observed_generate(client, observer))
+        await client.started.wait()
+        task.cancel()
+        with pytest.raises(asyncio.CancelledError):
+            await task
+        return observer
+
+    observer = asyncio.run(exercise())
+    assert [event[0] for event in observer.events] == ["before", "abort"]
+    assert observer.events[-1][2:] == ("post_unknown", "CancelledError")
+
+
