+def _strict_completion_logprobs(
+    choice: Mapping[str, Any],
+    completion_ids: list[int],
+) -> list[float]:
+    raw = choice.get("logprobs")
+    if not isinstance(raw, Mapping):
+        raise ValueError("generate response lacks completion logprobs")
+    content = raw.get("content")
+    if not isinstance(content, list) or len(content) != len(completion_ids):
+        raise ValueError("generate response token/logprob lengths differ")
+    values: list[float] = []
+    for item in content:
+        if not isinstance(item, Mapping) or "logprob" not in item:
+            raise ValueError("generate response has a malformed logprob entry")
+        value = item["logprob"]
+        if (
+            type(value) not in {int, float}
+            or not math.isfinite(value)
+            or value > 0.0
+        ):
+            raise ValueError("generate response logprobs must be finite and nonpositive")
+        values.append(float(value))
+    return values
+
+
+ObservationAbortPhase = Literal[
+    "post_unknown",
+    "response_received",
+    "response_parsed",
+    "typed_response",
+]
+
+
+@dataclass(frozen=True, slots=True)
+class PreparedGenerateRequest:
+    """Immutable evidence for the exact request about to cross the network."""
+
+    application_request: bytes
+    engine_endpoint: str
+    engine_request: bytes
+    engine_headers: bytes
+    observer_context: bytes
+    prompt_token_ids: tuple[int, ...]
+
+
+class PreparedGenerateObserver(Protocol):
+    """Exactly-once observer used by scientific clients at the POST boundary."""
+
+    async def before_forward(self, prepared: PreparedGenerateRequest) -> object: ...
+
+    async def after_response(self, ticket: object, response: object) -> None: ...
+
+    async def abort(
+        self,
+        ticket: object,
+        phase: ObservationAbortPhase,
+        error: BaseException,
+    ) -> None: ...
+
+
+def _canonical_json(value: object) -> bytes:
+    return json.dumps(
+        value,
+        allow_nan=False,
+        ensure_ascii=False,
+        separators=(",", ":"),
+        sort_keys=True,
+    ).encode("utf-8")
+
+
+async def abort_prepared_observation(
+    observer: PreparedGenerateObserver,
+    ticket: object,
+    phase: ObservationAbortPhase,
+    error: BaseException,
+) -> None:
+    """Durably finish an abort even when the model-call task was cancelled."""
+    task = asyncio.create_task(observer.abort(ticket, phase, error))
+    try:
+        await asyncio.shield(task)
+    except asyncio.CancelledError:
+        await task
+
