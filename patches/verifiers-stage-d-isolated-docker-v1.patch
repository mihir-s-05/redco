diff --git a/tests/test_stage_d_isolated_docker.py b/tests/test_stage_d_isolated_docker.py
new file mode 100644
index 0000000..468bf47
--- /dev/null
+++ b/tests/test_stage_d_isolated_docker.py
@@ -0,0 +1,58 @@
+from __future__ import annotations
+
+import asyncio
+
+import pytest
+
+import verifiers.v1.runtimes.docker as docker_module
+from verifiers.v1.runtimes.base import ProgramResult
+from verifiers.v1.runtimes.docker import DockerConfig, DockerRuntime
+
+
+def test_execution_identity_activates_only_after_setup(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    captured: list[tuple[str, ...]] = []
+
+    async def fake_docker(*args: str) -> ProgramResult:
+        captured.append(args)
+        return ProgramResult(0, "", "")
+
+    monkeypatch.setattr(docker_module, "docker", fake_docker)
+    runtime = DockerRuntime(
+        DockerConfig(
+            allow=[],
+            execution_user="65534:65534",
+            execution_home="/tmp/redco-agent",
+        )
+    )
+    runtime._container = "fixture"
+
+    asyncio.run(runtime.run(["id", "-u"], {}))
+    assert "--user" not in captured[-1]
+
+    runtime._cut = True
+    runtime._execution_started = True
+    asyncio.run(runtime.run(["id", "-u"], {}))
+    assert captured[-1][0:3] == ("exec", "--user", "65534:65534")
+    assert "HOME=/tmp/redco-agent" in captured[-1]
+    assert "XDG_CACHE_HOME=/tmp/redco-agent/.cache" in captured[-1]
+
+
+def test_execution_identity_requires_a_paired_absolute_home() -> None:
+    with pytest.raises(ValueError, match="supplied together"):
+        DockerRuntime(DockerConfig(execution_user="65534:65534"))
+    with pytest.raises(ValueError, match="absolute"):
+        DockerRuntime(
+            DockerConfig(
+                execution_user="65534:65534",
+                execution_home="relative",
+            )
+        )
+
+
+def test_background_process_cannot_start_after_execution_cut() -> None:
+    runtime = DockerRuntime(DockerConfig())
+    runtime._execution_started = True
+    with pytest.raises(docker_module.SandboxError, match="cannot start"):
+        asyncio.run(runtime.run_background(["sleep", "1"], {}, "/tmp/log"))
