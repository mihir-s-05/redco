index 0000000..320569d
--- /dev/null
+++ b/tests/test_stage_d_patched_rlm_archive.py
@@ -0,0 +1,42 @@
+from __future__ import annotations
+
+import asyncio
+import hashlib
+from pathlib import Path
+
+import pytest
+
+from verifiers.v1.harnesses.rlm.harness import RLMHarness, RLMHarnessConfig
+from verifiers.v1.runtimes.base import ProgramResult
+
+
+class _Runtime:
+    def __init__(self) -> None:
+        self.writes: list[tuple[str, bytes]] = []
+        self.commands: list[list[str]] = []
+
+    async def write(self, path: str, value: bytes) -> None:
+        self.writes.append((path, value))
+
+    async def run(self, command: list[str], env: dict[str, str]) -> ProgramResult:
+        del env
+        self.commands.append(command)
+        return ProgramResult(0, "", "")
+
+
+def test_exact_patched_archive_is_uploaded_before_install(tmp_path: Path) -> None:
+    archive = tmp_path / "rlm.tar"
+    archive.write_bytes(b"exact-patched-rlm")
+    config = RLMHarnessConfig(
+        checkout_archive_path=str(archive),
+        checkout_archive_sha256=hashlib.sha256(archive.read_bytes()).hexdigest(),
+    )
+    runtime = _Runtime()
+    asyncio.run(RLMHarness(config).setup(runtime))  # type: ignore[arg-type]
+    assert runtime.writes == [("/tmp/redco-patched-rlm.tar", archive.read_bytes())]
+    assert "git clone" not in runtime.commands[0][-1]
+
+
+def test_patched_archive_hash_is_mandatory(tmp_path: Path) -> None:
+    with pytest.raises(ValueError, match="supplied together"):
+        RLMHarnessConfig(checkout_archive_path=str(tmp_path / "rlm.tar"))
