+def clipped_node_loss(
+    inputs: LossInputs,
+    *,
+    clip_epsilon: float = 0.2,
+    kl_tau: float = 1e-3,
+    ratio_mode: str = "exact_sequence",
+) -> LossOutputs:
+    """PPO-style clipped surrogate over one complete policy decision."""
+    if inputs.loss_weights is None:
+        raise ValueError("clipped node loss requires explicit RL weights")
+    if not 0.0 < clip_epsilon < 1.0:
+        raise ValueError("clip_epsilon must be in (0, 1)")
+    mask = inputs.loss_mask
+    if not bool(mask.any()):
+        zero = inputs.trainer_logprobs.sum() * 0.0
+        return LossOutputs(
+            loss=zero,
+            metrics={
+                "redco_node_ratio": zero.detach(),
+                "redco_node_clipped": zero.detach(),
+                "redco_node_kl": zero.detach(),
+            },
+        )
+    advantages = inputs.advantages[mask]
+    if not torch.allclose(advantages, advantages[0].expand_as(advantages)):
+        raise ValueError("one node sequence must carry one scalar advantage")
+    weights = inputs.loss_weights[mask]
+    if not torch.allclose(weights, weights[0].expand_as(weights)):
+        raise ValueError("one node sequence must carry one decision-unit weight")
+
+    token_log_ratios = (
+        inputs.trainer_logprobs[mask] - inputs.inference_logprobs[mask]
+    )
+    if ratio_mode == "exact_sequence":
+        node_log_ratio = token_log_ratios.sum()
+    elif ratio_mode == "geometric_mean":
+        node_log_ratio = token_log_ratios.mean()
+    else:
+        raise ValueError(
+            "ratio_mode must be 'exact_sequence' or 'geometric_mean'"
+        )
+    ratio = node_log_ratio.exp()
+    clipped_ratio = ratio.clamp(1.0 - clip_epsilon, 1.0 + clip_epsilon)
+    advantage = advantages[0]
+    surrogate = torch.minimum(ratio * advantage, clipped_ratio * advantage)
+    node_weight = weights[0]
+    kl = node_log_ratio.square()
+    loss = node_weight * (-surrogate + kl_tau * kl)
+    clipped = (
+        ((advantage >= 0) & (ratio > 1.0 + clip_epsilon))
+        | ((advantage < 0) & (ratio < 1.0 - clip_epsilon))
+    ).to(ratio.dtype)
+    return LossOutputs(
+        loss=loss,
+        metrics={
+            "redco_node_ratio": ratio.detach(),
+            "redco_node_clipped": clipped.detach(),
+            "redco_node_kl": kl.detach(),
+        },
+    )
