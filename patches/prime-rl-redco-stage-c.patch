index 000000000..d34a2dbbf
--- /dev/null
+++ b/src/prime_rl/orchestrator/algo/redco.py
@@ -0,0 +1,163 @@
+from __future__ import annotations
+
+from collections import defaultdict
+from typing import TYPE_CHECKING, Any, cast
+
+from redco.algo.branching import TokenSpan, trajectory_rloo
+from redco.algo.training import (
+    BranchActionExample,
+    PolicyDecision,
+    SequenceExample,
+    compile_stage_c_records,
+)
+
+from prime_rl.configs.algorithm import RedcoAlgoConfig
+from prime_rl.orchestrator.algo.base import Algorithm
+
+if TYPE_CHECKING:
+    from prime_rl.orchestrator.types import Rollout
+    from prime_rl.transport import TrainingSample
+    from prime_rl.utils.client import InferencePool
+
+
+def _metadata(rollout: Rollout) -> dict[str, Any]:
+    value = rollout.info.get("redco")
+    if not isinstance(value, dict):
+        raise ValueError("ReDCO rollout is missing info.redco metadata")
+    return cast(dict[str, Any], value)
+
+
+def _single_sample(rollout: Rollout) -> TrainingSample:
+    if len(rollout.samples) != 1:
+        raise ValueError("clean Stage C requires one linear sample per branch")
+    return rollout.samples[0]
+
+
+def _action_span(sample: TrainingSample) -> TokenSpan:
+    selected = [index for index, trainable in enumerate(sample.mask) if trainable]
+    if not selected:
+        raise ValueError("ReDCO branch has no trainable action tokens")
+    span = TokenSpan(selected[0], selected[-1] + 1)
+    if selected != list(range(span.start, span.stop)):
+        raise ValueError("clean Stage C requires one contiguous action span")
+    return span
+
+
+def _sequence(sample: TrainingSample) -> SequenceExample:
+    return SequenceExample(
+        tuple(sample.token_ids),
+        tuple(sample.mask),
+        tuple(sample.logprobs),
+        sample.env_name,
+    )
+
+
+class RedcoAlgorithm(Algorithm):
+    """Stage-C all-branch LOO credit with decision-unit normalization."""
+
+    requires_complete_group = True
+
+    def __init__(self, config: RedcoAlgoConfig, policy_pool: InferencePool):
+        super().__init__(config, policy_pool)
+        self.replay_mode = config.replay_mode
+        self._latest_policy_version: int | None = None
+
+    async def score_group(self, group: list[Rollout]) -> None:
+        policy_versions = {rollout.policy_version for rollout in group}
+        if len(policy_versions) != 1:
+            raise ValueError("rollout and branch roles must use one policy snapshot")
+        if any(rollout.off_policy_steps != 0 for rollout in group):
+            raise ValueError("clean Stage C refuses off-policy rollouts")
+        (policy_version,) = policy_versions
+        if self._latest_policy_version is not None and policy_version < self._latest_policy_version:
+            raise ValueError("clean Stage C refuses a stale policy snapshot after version advance")
+        if self._latest_policy_version is None or policy_version > self._latest_policy_version:
+            self._latest_policy_version = policy_version
+
+        by_episode: dict[str, list[Rollout]] = defaultdict(list)
+        for rollout in group:
+            metadata = _metadata(rollout)
+            if metadata.get("selected_pre_action") is not True:
+                raise ValueError("target must be committed before action sampling")
+            if metadata.get("replay_mode") != self.replay_mode:
+                raise ValueError("rollout replay mode differs from algorithm config")
+            if metadata.get("replay_equivalent") is not True:
+                raise ValueError("sliced and full replay disagree in-loop")
+            by_episode[rollout.episode_id].append(rollout)
+
+        contexts: list[Rollout] = []
+        ordered_episodes: list[tuple[Rollout, list[Rollout]]] = []
+        for episode_id, rollouts in sorted(by_episode.items()):
+            if not episode_id:
+                raise ValueError("ReDCO branch records require an episode id")
+            context = [rollout for rollout in rollouts if _metadata(rollout).get("record_kind") == "context"]
+            branches = [rollout for rollout in rollouts if _metadata(rollout).get("record_kind") == "branch"]
+            if len(context) != 1:
+                raise ValueError("each ReDCO episode requires one context trace")
+            ordered = sorted(
+                branches,
+                key=lambda rollout: int(_metadata(rollout)["branch_index"]),
+            )
+            indices = [int(_metadata(rollout)["branch_index"]) for rollout in ordered]
+            if indices != [0, 1, 2, 3]:
+                raise ValueError("each ReDCO episode requires branch indices 0..3")
+            if _metadata(ordered[0]).get("action_source") != "original":
+                raise ValueError("branch zero must be the original action")
+            if any(_metadata(rollout).get("action_source") != "sampled" for rollout in ordered[1:]):
+                raise ValueError("branches one through three must be sampled")
+            contexts.append(context[0])
+            ordered_episodes.append((context[0], ordered))
+
+        if len(contexts) < 2:
+            raise ValueError("ReDCO trajectory LOO requires at least two complete episodes")
+        trajectory_advantages = trajectory_rloo(tuple(rollout.reward for rollout in contexts))
+        for trajectory_advantage, (context, branches) in zip(
+            trajectory_advantages,
+            ordered_episodes,
+            strict=True,
+        ):
+            context_sample = _single_sample(context)
+            context.assign_advantages(float(trajectory_advantage))
+            context_sample.rl_weights = [1.0 if trainable else 0.0 for trainable in context_sample.mask]
+            context_sample.rl_normalizer = 1.0
+
+            original = branches[0]
+            original_sample = _single_sample(original)
+            original_metadata = _metadata(original)
+            target_node_id = str(original_metadata["target_node_id"])
+            target_span = _action_span(original_sample)
+            branch_examples = tuple(
+                BranchActionExample(
+                    _sequence(sample := _single_sample(branch)),
+                    _action_span(sample),
+                    branch.reward,
+                    "original" if index == 0 else "sampled",
+                )
+                for index, branch in enumerate(branches)
+            )
+            records = compile_stage_c_records(
+                incumbent=_sequence(original_sample),
+                decisions=(
+                    PolicyDecision(
+                        target_node_id,
+                        target_span,
+                        float(original_metadata.get("outer_weight", 1.0)),
+                    ),
+                ),
+                trajectory_advantage=trajectory_advantage,
+                target_node_id=target_node_id,
+                branches=branch_examples,
+            )
+            if len(records) != 4:
+                raise RuntimeError("single-decision Stage C must emit four records")
+            for branch, record in zip(branches, records, strict=True):
+                branch.assign_advantages(list(record.advantages))
+                sample = _single_sample(branch)
+                sample.rl_weights = list(record.rl_weights)
+                sample.rl_normalizer = record.decision_unit_normalizer
+                assert record.branch_index is not None
+                action_span = branch_examples[record.branch_index].action_span
+                branch.record_metric(
+                    "redco_branch_advantage",
+                    record.advantages[action_span.start],
+                )
