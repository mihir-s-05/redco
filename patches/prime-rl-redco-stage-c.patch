+            "target_node_id": "subcall-0",
+            "selected_pre_action": True,
+            "replay_mode": "sliced",
+            "replay_equivalent": True,
+        }
+        group.append(context)
+        for branch_index, reward in enumerate(rewards):
+            rollout = _make_rollout(reward, completion_len=2)
+            rollout.episode_id = f"episode-{episode_index}"
