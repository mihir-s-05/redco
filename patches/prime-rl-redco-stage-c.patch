+def test_redco_assigns_all_branch_loo_with_one_unit_per_episode():
+    group: list[Rollout] = []
+    reward_groups = (
+        (1.0, 0.0, 0.5, -1.0),
+        (0.0, 1.0, -0.5, 0.25),
+    )
+    for episode_index, rewards in enumerate(reward_groups):
+        context = _make_rollout(rewards[0], completion_len=2)
+        context.episode_id = f"episode-{episode_index}"
+        context.policy_version = 7
+        context.info["redco"] = {
+            "record_kind": "context",
+            "target_node_id": "subcall-0",
+            "selected_pre_action": True,
+            "replay_mode": "sliced",
+            "replay_equivalent": True,
+        }
+        group.append(context)
+        for branch_index, reward in enumerate(rewards):
+            rollout = _make_rollout(reward, completion_len=2)
+            rollout.episode_id = f"episode-{episode_index}"
+            rollout.policy_version = 7
+            rollout.info["redco"] = {
+                "record_kind": "branch",
+                "branch_index": branch_index,
+                "action_source": "original"
+                if branch_index == 0
+                else "sampled",
+                "target_node_id": "subcall-0",
+                "selected_pre_action": True,
+                "replay_mode": "sliced",
+                "replay_equivalent": True,
+            }
+            group.append(rollout)
+
+    algorithm = RedcoAlgorithm(RedcoAlgoConfig(), policy_pool=None)
+    asyncio.run(algorithm.finalize_group(group))
+
+    for episode_index, rewards in enumerate(reward_groups):
+        expected = [
+            reward - (sum(rewards) - reward) / 3
+            for reward in rewards
+        ]
+        episode = group[episode_index * 5 : (episode_index + 1) * 5]
+        context, *branches = episode
+        expected_trajectory = rewards[0] - reward_groups[1 - episode_index][0]
+        assert context.samples[0].advantages == pytest.approx(
+            [0.0, expected_trajectory, expected_trajectory]
+        )
+        assert context.samples[0].rl_weights == [0.0, 1.0, 1.0]
+        assert context.samples[0].rl_normalizer == 1.0
+        for rollout, advantage in zip(branches, expected, strict=True):
+            sample = rollout.samples[0]
+            assert sample.advantages == pytest.approx([0.0, advantage, advantage])
+            assert sample.rl_weights == [0.0, 0.25, 0.25]
+            assert sample.rl_normalizer == 0.25
+
+    # Prime may collect several usable groups before one optimizer update. Reusing
+    # the current snapshot is valid; reopening it after an advance is not.
+    asyncio.run(algorithm.finalize_group(group))
+    for rollout in group:
+        rollout.policy_version = 8
+    asyncio.run(algorithm.finalize_group(group))
+    for rollout in group:
+        rollout.policy_version = 7
+    with pytest.raises(ValueError, match="stale policy snapshot"):
+        asyncio.run(algorithm.finalize_group(group))
+
+
