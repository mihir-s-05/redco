+import pytest
+import torch
+
+from prime_rl.trainer.rl.loss import LossInputs
+from prime_rl.trainer.rl.redco_loss import clean_decision_loss
+
+
+def test_clean_decision_loss_sums_tokens_with_explicit_outer_weight():
+    trainer_logprobs = torch.tensor([-0.2, -0.3, -0.4])
+    inputs = LossInputs(
+        trainer_logprobs=trainer_logprobs,
+        inference_logprobs=trainer_logprobs.clone(),
+        ref_logprobs=None,
+        advantages=torch.tensor([0.0, 2.0, 2.0]),
+        loss_mask=torch.tensor([False, True, True]),
+        loss_weights=torch.tensor([0.0, 0.25, 0.25]),
+    )
+
+    result = clean_decision_loss(inputs, kl_tau=0.0)
+
+    assert result.loss.item() == pytest.approx(0.35)
+    assert result.metrics["redco_decision_kl"].item() == 0.0
+
+
+def test_clean_decision_loss_refuses_implicit_token_weighting():
+    inputs = LossInputs(
+        trainer_logprobs=torch.tensor([-0.2]),
+        inference_logprobs=torch.tensor([-0.2]),
+        ref_logprobs=None,
+        advantages=torch.tensor([1.0]),
+        loss_mask=torch.tensor([True]),
+    )
+
+    with pytest.raises(ValueError, match="explicit RL weights"):
+        clean_decision_loss(inputs)
