+    assert dispatcher.can_open_fresh_train_group()
+
+    dispatcher.train_groups_started_by_policy[4] = 2
+    assert not dispatcher.can_open_fresh_train_group()
+
+    dispatcher.policy.version = 5
+    assert dispatcher.can_open_fresh_train_group()
+
+    dispatcher.eval_source = [object()]
+    assert not dispatcher.can_open_fresh_train_group()
+
+
+def test_strict_snapshot_waits_until_weights_are_fully_applied():
+    async def run() -> None:
+        orchestrator = object.__new__(Orchestrator)
+        orchestrator.applied_policy_version = 2
+        orchestrator.version_applied = asyncio.Event()
+
+        waiter = asyncio.create_task(orchestrator.wait_for_applied_policy(3))
+        await asyncio.sleep(0)
+        assert not waiter.done()
+
+        orchestrator.applied_policy_version = 3
+        orchestrator.version_applied.set()
+        await asyncio.wait_for(waiter, timeout=1)
+
+        # An already-applied snapshot must not wait for another event pulse.
+        await asyncio.wait_for(orchestrator.wait_for_applied_policy(3), timeout=1)
+
+    asyncio.run(run())
