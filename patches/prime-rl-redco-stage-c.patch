diff --git a/src/prime_rl/trainer/rl/redco_loss.py b/src/prime_rl/trainer/rl/redco_loss.py
new file mode 100644
index 000000000..e6e4d5c72
--- /dev/null
+++ b/src/prime_rl/trainer/rl/redco_loss.py
@@ -0,0 +1,41 @@
+from __future__ import annotations
+
+import torch
+
+from prime_rl.trainer.rl.loss import (
+    LossInputs,
+    LossOutputs,
+    compute_importance_ratio_and_mismatch_kl,
+)
+
+
+def clean_decision_loss(
+    inputs: LossInputs,
+    *,
+    kl_tau: float = 1e-3,
+) -> LossOutputs:
+    """Near-on-policy node-summed REINFORCE with a separate KL penalty."""
+    if inputs.loss_weights is None:
+        raise ValueError("clean decision loss requires explicit RL weights")
+    mask = inputs.loss_mask
+    weights = inputs.loss_weights
+    log_ratio, _, mismatch_kl = compute_importance_ratio_and_mismatch_kl(
+        inputs.trainer_logprobs,
+        inputs.inference_logprobs,
+    )
+    policy_gradient = -(
+        inputs.advantages * inputs.trainer_logprobs * weights
+    )[mask].sum()
+    kl = (log_ratio.square() * weights)[mask].sum()
+    return LossOutputs(
+        loss=policy_gradient + kl_tau * kl,
+        metrics={
+            "redco_decision_pg": policy_gradient.detach(),
+            "redco_decision_kl": kl.detach(),
+            "redco_mismatch_kl": (
+                mismatch_kl[mask].mean()
+                if bool(mask.any())
+                else torch.zeros((), device=mask.device)
+            ),
+        },
+    )
