+def test_prepared_return_skips_post_but_uses_the_same_parser():
+    class ReturningObserver(_PreparedObserver):
+        async def before_forward(self, prepared):
+            self.events.append(("before", prepared))
+            return PreparedGenerateReturn(
+                ticket="return-ticket",
+                response_content=_frozen_response_content(),
+            )
+
+    client = _FakeClient()
+    observer = ReturningObserver()
+    result = asyncio.run(_observed_generate(client, observer))
+
+    assert client.calls == []
+    assert result["request_id"] == "recorded-action"
+    assert result["completion_ids"] == [7, 8]
+    assert result["completion_logprobs"] == [-0.1, -0.2]
+    assert result.pop("_prepared_observation_ticket") == "return-ticket"
+
+
+def test_prepared_return_restores_tool_call_finish_through_the_parser():
+    class ReturningObserver(_PreparedObserver):
+        async def before_forward(self, prepared):
+            self.events.append(("before", prepared))
+            return PreparedGenerateReturn(
+                ticket="return-ticket",
+                response_content=_frozen_response_content(),
+            )
+
+    client = _FakeClient()
+    observer = ReturningObserver()
+    result = asyncio.run(_observed_generate(client, observer))
+
+    assert client.calls == []
+    assert result["finish_reason"] == "tool_calls"
+    assert result.pop("_prepared_observation_ticket") == "return-ticket"
