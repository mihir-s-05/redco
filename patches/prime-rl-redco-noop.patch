+from prime_rl.orchestrator.algo.grpo import GRPOAlgorithm
+
+
+class RedcoNoopAlgorithm(GRPOAlgorithm):
+    """Stage-A ReDCO scaffold with exactly the stock GRPO implementation.
+
+    Deliberately do not override scoring or routing here. Inheriting the complete
+    implementation makes divergence from GRPO impossible while the registry,
+    config union, launch path, and artifact plumbing are exercised end to end.
+    Later stages replace this class with graph-aligned credit assignment.
+    """
