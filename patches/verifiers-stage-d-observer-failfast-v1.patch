+async def test_failed_observed_request_cancels_sibling_without_cancelling_owner() -> None:
+    observer = _Observer()
+    owner_started = asyncio.Event()
+    sibling_started = asyncio.Event()
+    fail_owner = asyncio.Event()
+    sibling_cancelled = asyncio.Event()
+    posts = 0
+
+    async def get_response(*args, **kwargs):
+        nonlocal posts
+        posts += 1
+        lineage = kwargs["observer_context"]["rlm"]["lineage"]
+        prepared = SimpleNamespace(observer_context=kwargs["observer_context"])
+        directive = await kwargs["observer"].before_forward(prepared)
+        ticket = directive.ticket
+        if lineage == _sibling_headers(0)["X-RLM-Lineage"]:
+            owner_started.set()
+            await fail_owner.wait()
+            error = ValueError("closed observer invariant")
+            await kwargs["observer"].abort(ticket, "post_unknown", error)
+            raise error
+        sibling_started.set()
+        try:
+            await asyncio.Future()
+        except asyncio.CancelledError as error:
+            await kwargs["observer"].abort(ticket, "post_unknown", error)
+            sibling_cancelled.set()
+            raise
+
+    client = SimpleNamespace(get_response=AsyncMock(side_effect=get_response))
+    trace = Trace(task=TraceTask(type="ObservedTask", data=TaskData(prompt="hello")))
+    session = RolloutSession(ModelContext("test-model", client), trace, observer=observer)
+    server = InterceptionServer()
+    server.sessions["secret"] = session
+    raw = json.dumps(
+        {"model": "ignored", "messages": [{"role": "user", "content": "hello"}]},
+        separators=(",", ":"),
+    ).encode()
+
+    owner = asyncio.create_task(
+        server.handle_request(_request(raw, _sibling_headers(0)), ChatDialect())
+    )
+    await owner_started.wait()
+    sibling = asyncio.create_task(
+        server.handle_request(_request(raw, _sibling_headers(1)), ChatDialect())
+    )
+    await sibling_started.wait()
+    fail_owner.set()
+    response = await asyncio.wait_for(owner, timeout=0.5)
+    assert sibling.done() is True
+    assert sibling not in session.tasks
+    assert sibling not in session.task_operations
+    await asyncio.wait_for(sibling_cancelled.wait(), timeout=0.5)
+    await asyncio.gather(sibling, return_exceptions=True)
+
+    assert response.status == 409
+    assert posts == 2
+    assert owner.cancelled() is False
+    assert sibling.cancelled() is True
+    assert session.failed_closed is True
+    assert session.error is not None
+    assert str(session.error) == "ValueError: closed observer invariant"
+    assert [event[0] for event in observer.events] == [
+        "before",
+        "before",
+        "abort",
+        "abort",
+    ]
+
+
+async def test_failed_observed_request_returns_409_to_coalesced_retry() -> None:
+    observer = _Observer()
+    started = asyncio.Event()
+    fail = asyncio.Event()
+    posts = 0
+
+    async def get_response(*args, **kwargs):
+        nonlocal posts
+        posts += 1
+        started.set()
+        await fail.wait()
+        raise ValueError("closed observer invariant")
+
+    client = SimpleNamespace(get_response=AsyncMock(side_effect=get_response))
+    trace = Trace(task=TraceTask(type="ObservedTask", data=TaskData(prompt="hello")))
+    session = RolloutSession(ModelContext("test-model", client), trace, observer=observer)
+    server = InterceptionServer()
+    server.sessions["secret"] = session
+    raw = json.dumps(
+        {"model": "ignored", "messages": [{"role": "user", "content": "hello"}]},
+        separators=(",", ":"),
+    ).encode()
+
+    owner = asyncio.create_task(
+        server.handle_request(_request(raw, _sibling_headers(0)), ChatDialect())
+    )
+    await started.wait()
+    retry = asyncio.create_task(
+        server.handle_request(_request(raw, _sibling_headers(0)), ChatDialect())
+    )
+    await asyncio.sleep(0)
+    fail.set()
+    owner_response, retry_response = await asyncio.wait_for(
+        asyncio.gather(owner, retry), timeout=0.5
+    )
+
+    assert owner_response.status == retry_response.status == 409
+    assert posts == 1
+    assert retry.cancelled() is False
+
