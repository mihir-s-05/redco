+def test_env_observer_receives_exact_resolved_agent_config_and_client() -> None:
+    class ObservedConfig(EnvConfig):
+        agent: AgentConfig = AgentConfig(harness=HarnessConfig(id="null"))
+
+    class ObservedEnv(Env[ObservedConfig]):
+        async def run(self, task, agents) -> None:
+            raise AssertionError("not used")
+
+        def prepared_call_observer(self, task, trace, agent_config, client):
+            self.seen = (task, trace, agent_config, client)
+            return _Observer()
+
+    env = object.__new__(ObservedEnv)
+    env.config = ObservedConfig.model_construct(
+        taskset=TasksetConfig(id="unused"),
+        agent=AgentConfig(harness=HarnessConfig(id="null")),
+    )
+    env._default_harness = HarnessConfig(id="null")
+    env._interception = None
+    env._shared_tools = {}
+    env._task_cls = Task
+    env._warned_resources = set()
+    env._agent_clients = {}
+    client = SimpleNamespace()
+    agents = env._episode_agents(
+        ModelContext("resolved-model", client),
+        None,
+        [],
+        None,
+        None,
+    )
+    task = Task(TaskData(prompt="hello"))
+    trace = Trace(task=TraceTask(type="ObservedTask", data=TaskData(prompt="hello")))
+
+    observer = agents.agent.observer_factory(task, trace)
+
+    assert isinstance(observer, _Observer)
+    seen_task, seen_trace, seen_config, seen_client = env.seen
+    assert seen_task is task
+    assert seen_trace is trace
+    assert seen_config is agents.agent.config
+    assert seen_config.model == "resolved-model"
+    assert seen_client is client
+    assert agents.agent.ctx.client is client
+
