+async def test_failed_observed_request_cannot_resample_on_sdk_retry() -> None:
+    observer = _Observer()
+    posts = 0
+
+    async def get_response(*args, **kwargs):
+        nonlocal posts
+        prepared = SimpleNamespace(observer_context=kwargs["observer_context"])
+        ticket = await kwargs["observer"].before_forward(prepared)
+        posts += 1
+        error = ConnectionError("unknown outcome")
+        await kwargs["observer"].abort(ticket, "post_unknown", error)
+        raise error
+
+    client = SimpleNamespace(get_response=AsyncMock(side_effect=get_response))
+    trace = Trace(task=TraceTask(type="ObservedTask", data=TaskData(prompt="hello")))
+    session = RolloutSession(ModelContext("test-model", client), trace, observer=observer)
+    server = InterceptionServer()
+    server.sessions["secret"] = session
+    raw = json.dumps(
+        {"model": "ignored", "messages": [{"role": "user", "content": "hello"}]},
+        separators=(",", ":"),
+    ).encode()
+    request = lambda: _request(raw, _sibling_headers(0))
+
+    first = await server.handle_request(request(), ChatDialect())
+    second = await server.handle_request(request(), ChatDialect())
+
+    assert first.status == 502 and second.status == 502
+    assert posts == 1
+    assert [event[0] for event in observer.events] == ["before", "abort"]
