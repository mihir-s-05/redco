+class _Observer:
+    def __init__(self) -> None:
+        self.reserved: set[str] = set()
+        self.events: list[tuple] = []
+
+    async def before_forward(self, prepared):
+        lineage = prepared.observer_context["rlm"]["lineage"]
+        if lineage in self.reserved:
+            raise ValueError("duplicate observed policy event")
+        self.reserved.add(lineage)
+        self.events.append(("before", lineage))
+        return lineage
+
+    async def after_response(self, ticket, response):
+        self.events.append(("after", ticket))
+
+    async def abort(self, ticket, phase, error):
+        self.events.append(("abort", ticket, phase, type(error).__name__))
+
+
+def _request(raw: bytes, headers: dict[str, str], *, stream: bool = False):
+    wire_headers = CIMultiDict(headers)
+    wire_headers["Authorization"] = "Bearer secret"
+    payload = json.loads(raw)
+    if stream:
+        payload["stream"] = True
+        raw = json.dumps(payload, separators=(",", ":")).encode()
+    return SimpleNamespace(
+        headers=wire_headers,
+        path="/v1/chat/completions",
+        read=AsyncMock(return_value=raw),
+        _read_bytes=raw,
+    )
+
