+async def test_observed_success_is_replayed_without_reinvoking_observer() -> None:
+    observer = _Observer()
+    calls = 0
+
+    async def get_response(*args, **kwargs):
+        nonlocal calls
+        calls += 1
+        prepared = SimpleNamespace(observer_context=kwargs["observer_context"])
+        ticket = await kwargs["observer"].before_forward(prepared)
+        response = Response(
+            id="completion",
+            created=1,
+            model="test-model",
+            message=AssistantMessage(content="done"),
+            finish_reason="stop",
+            raw={"choices": [{"message": {"role": "assistant", "content": "done"}}]},
+        )
+        await kwargs["observer"].after_response(ticket, response)
+        return response
+
+    client = SimpleNamespace(get_response=AsyncMock(side_effect=get_response))
+    trace = Trace(task=TraceTask(type="ObservedTask", data=TaskData(prompt="hello")))
+    session = RolloutSession(ModelContext("test-model", client), trace, observer=observer)
+    server = InterceptionServer()
+    server.sessions["secret"] = session
+    raw = json.dumps(
+        {"model": "ignored", "messages": [{"role": "user", "content": "hello"}]},
+        separators=(",", ":"),
+    ).encode()
+
+    await server.handle_request(_request(raw, _sibling_headers(0)), ChatDialect())
+    await server.handle_request(_request(raw, _sibling_headers(0)), ChatDialect())
+
+    assert calls == 1
+    assert observer.events == [
+        ("before", _sibling_headers(0)["X-RLM-Lineage"]),
+        ("after", _sibling_headers(0)["X-RLM-Lineage"]),
+    ]
+
