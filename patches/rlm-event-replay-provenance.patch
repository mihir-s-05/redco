 """Public Python API for running rlm agents."""
 
+import json
 import os
+from pathlib import Path
 
 from rlm.engine import RLMEngine
 from rlm.session import Session
 from rlm.types import RLMResult
 
 
-def _child_session() -> Session | None:
+def _invocation_id(value: object) -> str:
+    if not isinstance(value, str):
+        raise TypeError("redco_invocation_id must be a string")
+    if not value or len(value) > 128 or not value.isprintable():
+        raise ValueError("redco_invocation_id must be 1-128 printable characters")
+    return value
+
+
+def _child_session(invocation_id: object) -> Session | None:
     """If inside a parent session (depth > 0), create a child under it."""
     parent_dir = os.environ.get("RLM_SESSION_DIR")
     depth = int(os.environ.get("RLM_DEPTH", "0"))
     if parent_dir and depth > 0:
-        return Session(Session.child_dir(parent_dir))
+        parent_path = Path(parent_dir)
+        parent_turn, parent_tool_call_id = _latest_parent_tool_call(
+            parent_path / "messages.jsonl"
+        )
+        normalized_invocation_id = _invocation_id(invocation_id)
+        child = Session(
+            Session.child_dir(parent_path),
+            parent_session_id=parent_path.name,
+            parent_turn=parent_turn,
+            parent_tool_call_id=parent_tool_call_id,
+            invocation_id=normalized_invocation_id,
+        )
+        child.write_meta(
+            parent_session_id=parent_path.name,
+            parent_turn=parent_turn,
+            parent_tool_call_id=parent_tool_call_id,
+            invocation_id=normalized_invocation_id,
+        )
+        return child
     return None
 
 
+def _latest_parent_tool_call(messages_path: Path) -> tuple[int, str]:
+    """Return the exact parent turn and tool call that spawned this child."""
+    try:
+        lines = messages_path.read_text().splitlines()
+    except FileNotFoundError as error:
+        raise RuntimeError("parent RLM message log is unavailable") from error
+    for line in reversed(lines):
+        entry = json.loads(line)
+        if entry.get("type") != "assistant":
+            continue
+        tool_calls = entry.get("tool_calls")
+        if not isinstance(tool_calls, list):
+            continue
+        ipython_calls = [
+            call
+            for call in tool_calls
+            if isinstance(call, dict) and call.get("name") == "ipython"
+        ]
+        if len(ipython_calls) != 1:
+            continue
+        turn = entry.get("turn")
+        tool_call_id = ipython_calls[0].get("id")
+        if (
+            type(turn) is int
+            and turn >= 0
+            and isinstance(tool_call_id, str)
+            and tool_call_id
+        ):
+            return turn, tool_call_id
+    raise RuntimeError("parent RLM IPython turn is unavailable")
+
+
 async def run(prompt: str, **kwargs) -> RLMResult:
     """Run a single rlm agent."""
+    invocation_id = kwargs.pop("redco_invocation_id", None)
     if "session" not in kwargs:
-        child = _child_session()
+        child = _child_session(invocation_id)
         if child:
             kwargs["session"] = child
     engine = RLMEngine(**kwargs)
