     ]


+async def test_sampling_director_prepares_application_and_client_from_same_config() -> None:
+    observed: dict[str, object] = {}
+
+    class Director:
+        def direct_sampling(self, context, sampling):
+            assert context["rlm"]["lineage"] == _sibling_headers(0)["X-RLM-Lineage"]
+            extra_body = dict(sampling.extra_body)
+            extra_body["cache_salt"] = "directed-salt"
+            return sampling.model_copy(
+                update={"seed": 9001, "extra_body": extra_body},
+                deep=True,
+            )
+
+    async def get_response(*args, **kwargs):
+        sampling = args[3]
+        observed["sampling"] = sampling.model_dump(mode="json", exclude_none=False)
+        observed["effective"] = kwargs["effective_request"]
+        return Response(
+            id="completion",
+            created=1,
+            model="test-model",
+            message=AssistantMessage(content="done"),
+            finish_reason="stop",
+            raw={"choices": [{"message": {"role": "assistant", "content": "done"}}]},
+        )
+
+    client = SimpleNamespace(get_response=AsyncMock(side_effect=get_response))
+    base = SamplingConfig(
+        temperature=0.2,
+        seed=7,
+        extra_body={"cache_salt": "base-salt"},
+    )
+    trace = Trace(task=TraceTask(type="DirectedTask", data=TaskData(prompt="hello")))
+    session = RolloutSession(
+        ModelContext("test-model", client, base),
+        trace,
+        sampling_director=Director(),
+    )
+    server = InterceptionServer()
+    server.sessions["secret"] = session
+    raw = json.dumps(
+        {"model": "ignored", "messages": [{"role": "user", "content": "hello"}]},
+        separators=(",", ":"),
+    ).encode()
+
+    await server.handle_request(_request(raw, _sibling_headers(0)), ChatDialect())
+
+    sampling = observed["sampling"]
+    effective = observed["effective"]
+    assert sampling["seed"] == effective["seed"] == 9001
+    assert sampling["extra_body"] == effective["extra_body"] == {
+        "cache_salt": "directed-salt"
+    }
+    assert base.seed == 7
+    assert base.extra_body == {"cache_salt": "base-salt"}
+
+
 async def test_failed_observed_request_cannot_resample_on_sdk_retry() -> None:
